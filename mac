end)

Reopen.MouseButton1Click:Connect(function()
    Main.Visible = true
    Reopen.Visible = false
end)

-- Drag panel by header
local dragging = false
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

-- Controller shortcuts
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not Enabled then return end

    local key = input.KeyCode

    if key == rpgButton then
        runMacro("RPG", RPGMacro)
    elseif key == taserButton then
        runMacro("Taser", TaserMacro)
    elseif key == snowButton then
        runMacro("Snow", SnowMacro)
    elseif key == comboButton then
        runMacro("Combo", WeaponMacro)
    elseif key == boardButton then
        runMacro("Board", BoardMacro)
    elseif key == brassButton then
        runMacro("Brass", BrassMacro)
    elseif key == Enum.KeyCode.X
    or key == Enum.KeyCode.ButtonX then
        if not Busy then ReloadMacro() end
    end
end)

print("♡ FatimaBowsMacro panel loaded!")
