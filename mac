
-- FATIMABOWSMACRO
-- Controller Macros + Transparent Panel

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer
local Enabled = true
local Busy = false
local Speed = 2

local snowButton = Enum.KeyCode.ButtonY
local comboButton = Enum.KeyCode.ButtonL3
local rpgButton = Enum.KeyCode.ButtonL1
local taserButton = Enum.KeyCode.ButtonR1
local boardButton = Enum.KeyCode.DPadLeft
local brassButton = Enum.KeyCode.DPadRight

local cooldowns = {
    Snow = 0.2,
    Combo = 0.2,
    RPG = 0.25,
    Taser = 0.25,
    Board = 0.2,
    Brass = 0.2
}

local ready = {
    Snow = true,
    Combo = true,
    RPG = true,
    Taser = true,
    Board = true,
    Brass = true
}

local function tapCenter()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local size = camera.ViewportSize
    local x, y = size.X / 2, size.Y / 2

    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function pressKey(key)
    VIM:SendKeyEvent(true, key, false, game)
    VIM:SendKeyEvent(false, key, false, game)
end

local slotKeys = {
    [0] = Enum.KeyCode.Zero,
    [1] = Enum.KeyCode.One,
    [2] = Enum.KeyCode.Two,
    [3] = Enum.KeyCode.Three,
    [4] = Enum.KeyCode.Four,
    [5] = Enum.KeyCode.Five,
    [6] = Enum.KeyCode.Six,
    [7] = Enum.KeyCode.Seven,
    [8] = Enum.KeyCode.Eight,
    [9] = Enum.KeyCode.Nine
}

local function equip(slot)
    local key = slotKeys[slot]
    if key then pressKey(key) end
end

local function returnToBoard()
    equip(2)
    tapCenter()
end

local function runMacro(name, callback)
    if not Enabled or Busy or not ready[name] then return end

    ready[name] = false
    Busy = true

    task.spawn(function()
        local ok, err = pcall(callback)

        if not ok then
            warn("[FatimaBowsMacro] " .. tostring(err))
        end

        Busy = false
        task.wait(cooldowns[name])
        ready[name] = true
    end)
end

local function SnowMacro()
    equip(8)
    tapCenter()
    task.wait(0.05)

    equip(9)
    tapCenter()
    task.wait(0.05)

    returnToBoard()
end

local function WeaponMacro()
    for slot = 4, 7 do
        equip(slot)
        tapCenter()
        task.wait(0.05 / Speed)
    end

    returnToBoard()
end

local function RPGMacro()
    equip(1)
    tapCenter()
    task.wait(0.05)
    returnToBoard()
end

local function TaserMacro()
    equip(3)
    tapCenter()
    task.wait(0.05)
    returnToBoard()
end

local function BoardMacro()
    returnToBoard()
end

local function BrassMacro()
    equip(0)
end

local function ReloadMacro()
    pressKey(Enum.KeyCode.X)
end

